APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
PPOB_LOG_LEVEL=info
PPOB_LOG_DAILY_DAYS=30
PPOB_ALERT_CHANNELS=ppob

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_ALLOWED_LOCAL_PATHS=avatars,articles,videos
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_TESTING=false
DIGIFLAZZ_TIMEOUT=30

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_BASE_URL=
MIDTRANS_API_BASE_URL=
MIDTRANS_FINISH_URL=
MIDTRANS_ENABLED_PAYMENTS=bri_va,bca_va,bni_va,echannel,permata_va,qris,gopay,shopeepay
MIDTRANS_EXPIRY_MINUTES=60
MIDTRANS_TIMEOUT=30

TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_RETURN_URL=
TRIPAY_EXPIRY_MINUTES=60
TRIPAY_TIMEOUT=30

PPOB_PAYMENT_GATEWAY=midtrans
PPOB_FULFILLMENT_DISPATCH=sync
PPOB_RECONCILE_BATCH_LIMIT=50
PPOB_RECONCILE_SCHEDULE_MINUTES=5
PPOB_MONITOR_SCHEDULE_MINUTES=5
PPOB_JOB_TRIES=5
PPOB_JOB_BACKOFF_SECONDS=30
PPOB_JOB_TIMEOUT_SECONDS=120
PPOB_JOB_LOCK_EXPIRE_SECONDS=300
PPOB_JOB_LOCK_RELEASE_SECONDS=30
PPOB_FAILURE_ALERT_WINDOW_MINUTES=15
PPOB_FAILURE_ALERT_THRESHOLD=3

VITE_APP_NAME="${APP_NAME}"
